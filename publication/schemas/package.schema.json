{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shockedbutnotsurprised.news/schemas/publication-package-1.0.json",
  "title": "SBNS publication package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approved_at",
    "human_decision",
    "source_analysis",
    "story",
    "editorial_guardrails"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "approved_at": { "type": "string", "format": "date-time" },
    "human_decision": { "const": "approve" },
    "source_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intake_id", "intake_origin", "submitted_url", "recommendation"],
      "properties": {
        "intake_id": { "type": "string", "minLength": 1 },
        "intake_origin": { "enum": ["editor", "visitor", "monitor", "discovery"] },
        "submitted_url": { "type": "string", "format": "uri" },
        "recommendation": { "enum": ["publish", "hold", "reject"] }
      }
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "content_type",
        "category",
        "headline",
        "summary",
        "fml_kicker",
        "severity",
        "topic_tags",
        "sources"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "content_type": { "const": "reporting" },
        "category": { "enum": ["International", "National", "Local"] },
        "headline": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "fml_kicker": { "type": "string", "minLength": 1 },
        "severity": { "type": "integer", "minimum": 1, "maximum": 5 },
        "topic_tags": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "url"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "format": "uri" }
            }
          }
        }
      }
    },
    "editorial_guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["do_not_claim", "qualification_required"],
      "properties": {
        "do_not_claim": {
          "type": "array",
          "items": { "type": "string" }
        },
        "qualification_required": { "type": "boolean" }
      }
    }
  }
}
