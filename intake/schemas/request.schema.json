{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shockedbutnotsurprised.news/schemas/intake-request-1.0.json",
  "title": "SBNS intake request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "submitted_url",
    "submitted_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "submitted_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
